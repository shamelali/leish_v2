# Copy to .env.local and adjust. Do NOT commit real secrets.

# ── Core ─────────────────────────────────────────────────────────────────────

# Public site URL used for metadataBase, sitemap, robots, verification/reset
# links, and Billplz callback/redirect URLs.
NEXT_PUBLIC_SITE_URL=https://leish.my

# REQUIRED in production. Signs session JWTs. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Optional: pepper for password hashing (HMAC-SHA256 before scrypt).
# Adds a server-side secret layer. Generate with:
#   openssl rand -hex 16
PEPPER_SECRET=

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED in production: the server refuses to boot without it, because the
# only fallback is an ephemeral SQLite file that loses every booking.
# Unset is fine for local development: the app then uses Node's built-in
# SQLite (./data/leish.db). In production set a PostgreSQL connection string
# (e.g. Neon / Supabase pooler):
#   postgresql://user:password@host/db?sslmode=require
# DATABASE_URL=

# Optional: override the SQLite database file path (defaults to ./data/leish.db)
# LEISH_DB_PATH=/var/data/leish.db

# PostgreSQL pool tuning (optional, only used when DATABASE_URL is set)
# PG_MAX=10
# PG_CONNECTION_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=10000

# ── Supabase (Storage & Auth) ────────────────────────────────────────────────
# Project URL and anon key from Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key for admin operations (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# ── Email delivery ───────────────────────────────────────────────────────────
# Default provider is "dev": messages are written to the email_outbox table and
# viewable at /dev/emails (non-production only). To send real email set one of:
#   EMAIL_PROVIDER=brevo   + BREVO_API_KEY        (recommended)
#   EMAIL_PROVIDER=resend  + RESEND_API_KEY
#   EMAIL_PROVIDER=postmark + POSTMARK_SERVER_TOKEN
#
# REQUIRED in production: validateEnv() fails the boot when no provider (and no
# provider credential) is configured. Production is the wrong place to silently
# swallow real booking/customer mail — set EMAIL_ALLOW_DEV=1 only if you
# genuinely want the outbox in production.
# EMAIL_PROVIDER=dev
# EMAIL_ALLOW_DEV=1
# BREVO_API_KEY=
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# EMAIL_FROM=Leish! <no-reply@leish.my>
#
# Vercel Connect email: If you've created API-key connectors in the Vercel
# Connect dashboard (api-key/resend, api-key/postmark, api-key/brevo), the
# app will resolve keys from Connect at runtime before falling back to the
# env vars above. This lets you manage email credentials centrally.

# ── Vercel Blob Storage (for artist/studio images, invoices, avatars) ─────────
# Create store: `vercel blob create-store leish-v2-blobs --access public`
# Or via dashboard: Storage → Blob → Create Store
# BLOB_READ_WRITE_TOKEN=

# ── Payments — Billplz (Malaysian gateway) ───────────────────────────────────
# REQUIRED in production unless PAYMENTS_ALLOW_DEV=1. Both values must be set
# together — a partial configuration fails the boot rather than silently
# falling back to the "dev" provider (which records payments without charging).
# BILLPLZ_API_KEY=
# BILLPLZ_COLLECTION_ID=
# (No separate signature key: webhook HMACs are verified with BILLPLZ_API_KEY.)
# Sandbox host (live default is https://www.billplz.com/api/v3). Never mix sandbox
# credentials with the live host.
# BILLPLZ_BASE_URL=https://www.billplz-sandbox.com/api/v3
# Optional callback/redirect overrides (default to {NEXT_PUBLIC_SITE_URL}/api/payments/webhook)
# BILLPLZ_CALLBACK_URL=
# BILLPLZ_REDIRECT_URL=

# Explicit opt-out: run production WITHOUT collecting money. Only valid when
# neither BILLPLZ_API_KEY nor BILLPLZ_COLLECTION_ID is set.
# PAYMENTS_ALLOW_DEV=1

# ── Facebook / Instagram (OAuth & Graph API) ──────────────────────────────────
# App from https://developers.facebook.com/apps/1953314715341668/
# Used for Facebook Login, Instagram Basic Display, and Graph API calls.
# FACEBOOK_APP_ID=1953314715341668
# FACEBOOK_APP_SECRET=

# ── Bot protection — Cloudflare Turnstile (optional) ─────────────────────────
# When both are set, register / login / forgot-password require a solved widget.
# Leave unset in local/e2e — verification is skipped.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Rate limiting is ALWAYS in-memory in this deployment (per instance, reset on
# cold start). These Upstash vars are NOT read by the rate limiter — they only
# configure the optional catalog cache below.
# UPSTASH_REST_URL=
# UPSTASH_REST_TOKEN=

# ── Upstash Redis (cache) ─────────────────────────────────────────────────────
# REST API credentials from Upstash console → your Redis instance → Connect.
# When set, catalog reads (artist/studio lookups, listings) are cached in Redis.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Cron / internal endpoints ────────────────────────────────────────────────
# REQUIRED in production. Protects /api/cron/* (Vercel Cron sends it as a
# Bearer token); INTERNAL_API_SECRET is accepted as an alternative for
# service-to-service callers. If neither is set in production the endpoints
# return 503 instead of running unauthenticated.
# CRON_SECRET=
# INTERNAL_API_SECRET=

# ── Admin seeding (one-off, not read by the app) ─────────────────────────────
# Used only by scripts/seed-admin.ts to create/upgrade the first admin user:
#   ADMIN_EMAIL=... ADMIN_PASSWORD=... npx tsx scripts/seed-admin.ts
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
#
# ── Catalog ──────────────────────────────────────────────────────────────────
# There is NO catalog seed: a fresh database starts with zero artists/studios
# and they are created by admins (/api/admin/artists) or via /api/onboarding.
# To strip leftover demo rows from an existing database:
#   npm run db:clear-catalog                 # dry run
#   npm run db:clear-catalog -- --force      # delete catalog rows

# ── Security (optional) ──────────────────────────────────────────────────────
# Comma-separated extra origins allowed for state-changing requests.
# ALLOWED_ORIGINS=
# Password pepper for scrypt hashing.
# PEPPER_SECRET=

# ── Vercel Connect (Slack notifications) ─────────────────────────────────────
# Runtime tokens managed by Vercel Connect — no Slack API key in env vars.
# Setup: create a Slack connector in Vercel dashboard → Link to project.
# SLACK_CHANNEL_ID=
# CONNECT_SLACK_CONNECTOR=slack/leish-slack

# ── Observability (optional) ─────────────────────────────────────────────────
# Structured logging level: trace | debug | info | warn | error
# LOG_LEVEL=info
# Forward every structured log line to a webhook (JSON batch).
# LOG_WEBHOOK_URL=
# Error reporting: SENTRY_DSN takes precedence; otherwise ERROR_WEBHOOK_URL
# receives a sanitized JSON payload. Both are POSTed from reportError().
# SENTRY_DSN=
# ERROR_WEBHOOK_URL=

# Agnost AI analytics (set AGNOST_ORG_ID to enable)
# AGNOST_ORG_ID=
AGNOST_ORG_ID="3e27e121-654d-4746-ba55-7996f21bb351"

# Agnost AI analytics (client-side tracking, optional)
# NEXT_PUBLIC_AGNOST_ORG_ID=
NEXT_PUBLIC_AGNOST_ORG_ID="3e27e121-654d-4746-ba55-7996f21bb351"

# ── Deployment ───────────────────────────────────────────────────────────────
# Vercel deploy hook — POST to this URL to trigger a production deployment.
# Create one at: https://vercel.com/<account>/<project>/settings/deploy-hooks
# Used by scripts/deploy.sh and GitHub Actions for automated deploys.
# VERCEL_DEPLOY_HOOK_URL=

# Vercel API token for deploy-status.sh (optional — only needed for status checks)
# Get one at: https://vercel.com/account/tokens
# VERCEL_ACCESS_TOKEN=
