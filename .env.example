# Copy to .env.local and adjust.

# Public site URL used for metadataBase, sitemap, robots, and as the base
# for verification/reset links and Billplz callback/redirect URLs.
NEXT_PUBLIC_SITE_URL=https://leish.my
NEXT_PUBLIC_URL=https://leish.my

# Supabase (Postgres database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database. Leave unset for local SQLite (node:sqlite, ./data/leish.db).
# Set to a PostgreSQL connection string (e.g. Neon/Supabase pooler) to use PostgreSQL:
#   postgresql://user:password@host/db?sslmode=require
# DATABASE_URL=

# REQUIRED in production. Secret used to sign session JWTs.
# Generate with: openssl rand -base64 32
SESSION_SECRET= placeholder_value_but_should_be_32 bit

# Optional: override the SQLite database file path (defaults to ./data/leish.db)
# LEISH_DB_PATH=/var/data/leish.db

# Email delivery.
# Brevo (transactional booking confirmation emails):
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=hello@leish.my
# BREVO_SENDER_NAME=Leish
#
# Dev outbox (default) stores messages in email_outbox, viewable at /dev/emails.
# EMAIL_PROVIDER=dev
RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# EMAIL_FROM=Leish! <no-reply@leish.my>
# DKIM: configure Resend domain settings for leish.my (TXT records in DNS)

# Distributed rate limiting (optional). Falls back to in-memory when unset.
# UPSTASH_REST_URL=
# UPSTASH_REST_TOKEN=

# Payments — Billplz (Malaysian gateway).
# BILLPLZ_API_KEY=
# BILLPLZ_COLLECTION_ID=
# BILLPLZ_X_SIGNATURE_KEY=
# BILLPLZ_BASE_URL=https://www.billplz.com/api/v3
# Optional overrides (default to {NEXT_PUBLIC_SITE_URL}/api/payments/webhook — the
# db-facade webhook; there is only one payment path):
# BILLPLZ_CALLBACK_URL=
# BILLPLZ_REDIRECT_URL=

# Structured logging level: trace | debug | info | warn | error
# LOG_LEVEL=info

# PDPA Malaysia compliance
# consent checkbox must be presented during registration
# consent_timestamp is logged when user consents

# PostgreSQL pool tuning (optional, when DATABASE_URL is set)
# PG_MAX=10
# PG_CONNECTION_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=10000

# Secret for the quotation-expiry cron and internal endpoints.
# CRON_SECRET=
# INTERNAL_API_SECRET=

# Observability: forward every structured log line to a webhook (JSON batch).
# LOG_WEBHOOK_URL=

# Error reporting (optional):
#   SENTRY_DSN takes precedence; otherwise ERROR_WEBHOOK_URL receives a
#   sanitized JSON payload. Both are POSTed from reportError().
# SENTRY_DSN=https://public_key@host/project_id
# ERROR_WEBHOOK_URL=
