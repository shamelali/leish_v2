{
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/quotation-expiry",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/balance-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/email-retries",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
