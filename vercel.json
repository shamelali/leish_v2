{
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/quotation-expiry",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/balance-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/email-retries",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/booking-transitions",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/payout-automation",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/review-requests",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/quotation-recovery",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
