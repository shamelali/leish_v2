{
  "name": "leish_v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "start:next": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:check": "node --experimental-strip-types -e \"import('./src/env.ts').then(m => m.validateEnv())\"",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:clear-catalog": "node --experimental-strip-types scripts/clear-catalog.ts",
    "chat:migrate": "node --experimental-strip-types scripts/migrate-chat.ts",
    "test:pg": "vitest run --config vitest.pg.config.mts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache",
    "chat:dev": "wrangler dev --config src/workers/chat/wrangler.jsonc",
    "chat:deploy": "wrangler deploy --config src/workers/chat/wrangler.jsonc",
    "cron:deploy": "wrangler deploy --config src/workers/cron/wrangler.jsonc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@getbrevo/brevo": "^6.2.0",
    "@neondatabase/serverless": "^1.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/redis": "^1.40.0",
    "agnostai": "^0.2.0",
    "jose": "6.2.13",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "@vinext/cloudflare": "1.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "axios": "^1.19.0",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "eslint": "9",
    "eslint-config-next": "16.4.3",
    "express": "^5.3.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "4",
    "typescript": "5",
    "vite": "^8.3.5",
    "vinext": "1.3.1",
    "vitest": "4.1.10",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@11.22.0",
  "type": "module"
}
