{
  "name": "leish_v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:check": "node --experimental-strip-types -e \"import('./src/env.ts').then(m => m.validateEnv())\"",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed-catalog": "node --experimental-strip-types scripts/seed-catalog.ts",
    "test:pg": "vitest run --config vitest.pg.config.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "jose": "6.2.8",
    "next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4",
    "typescript": "5",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.22.0"
}
