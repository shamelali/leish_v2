{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Main web app (vinext). The realtime chat worker is separate — see
  // src/workers/chat/wrangler.jsonc, deployed via `npm run chat:deploy`.
  "name": "leish-my",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "26565f2b5af4f08b4a28122e9484c9e4",
  // Serve the production apex from this Worker. The `leish.my` record is
  // proxied (orange cloud), so Cloudflare's edge runs this Worker instead of
  // fetching the origin. A custom_domain cannot be used: the apex already has
  // externally managed DNS records (Cloudflare error 100117).
  "routes": [
    {
      "pattern": "leish.my/*",
      "zone_name": "leish.my",
    },
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "cache": {
    "enabled": true,
  },
  "images": {
    "binding": "IMAGES",
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "5e38802efc7040c8b576f50a479ef3fc",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
